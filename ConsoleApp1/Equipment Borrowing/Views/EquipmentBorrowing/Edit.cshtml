@model EquipmentBorrowing
@{
    ViewData["Title"] = "Edit Transaction";
}

<div class="card shadow-sm">
    <div class="card-header bg-secondary text-white">
        <h4>Edit Loan Record: @Model.TransactionNumber</h4>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="TransactionNumber" />
            <input type="hidden" asp-for="Status" />
            <input type="hidden" asp-for="ActualReturnDateTime" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="BorrowerName" class="form-label"></label>
                    <input asp-for="BorrowerName" class="form-control" />
                    <span asp-validation-for="BorrowerName" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="BorrowerType" class="form-label"></label>
                    <select asp-for="BorrowerType" class="form-select">
                        <option value="Student">Student</option>
                        <option value="Faculty">Faculty</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="BorrowerId" class="form-label"></label>
                    <input asp-for="BorrowerId" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DepartmentOrCourse" class="form-label"></label>
                    <input asp-for="DepartmentOrCourse" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="EquipmentName" class="form-label"></label>
                    <input asp-for="EquipmentName" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="EquipmentCategory" class="form-label"></label>
                    <input asp-for="EquipmentCategory" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" class="form-control" type="number" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="BorrowDateTime" class="form-label"></label>
                    <input asp-for="BorrowDateTime" class="form-control" type="datetime-local" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ExpectedReturnDate" class="form-label"></label>
                    <input asp-for="ExpectedReturnDate" class="form-control" type="datetime-local" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Purpose" class="form-label"></label>
                <textarea asp-for="Purpose" class="form-control" rows="2"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Update Record</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>