@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center fade-in-up mt-4">
    <div class="col-md-6">
        <div class="card card-dark-glass p-4">
            <div class="card-body">
                <div class="text-center mb-4">
                    <div class="display-6 text-success mb-2">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <h3 class="fw-bold text-white">Create Account</h3>
                    <p class="text-secondary small">Register a new system user</p>
                </div>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label text-light">First Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input asp-for="FirstName" class="form-control" placeholder="John" />
                            </div>
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label text-light">Last Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary">
                                    <i class="bi bi-person"></i>
                                </span>
                                <input asp-for="LastName" class="form-control" placeholder="Doe" />
                            </div>
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label text-light">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary">
                                <i class="bi bi-envelope-fill"></i>
                            </span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                   
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label text-light">Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-secondary">
                                <i class="bi bi-person-badge-fill"></i>
                            </span>
                            <input asp-for="Username" class="form-control" placeholder="johndoe" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                   
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label text-light">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label text-light">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-secondary">
                                    <i class="bi bi-shield-check"></i>
                                </span>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    
                    <button type="submit" class="btn btn-success w-100 py-2 mt-2 btn-animated fw-bold">
                        <i class="bi bi-check-circle-fill me-1"></i> Register Account
                    </button>
                </form>

                <div class="text-center mt-4">
                    <small class="text-secondary">
                        Already registered? 
                        <a asp-action="Login" class="text-primary text-decoration-none fw-semibold">Login here</a>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>